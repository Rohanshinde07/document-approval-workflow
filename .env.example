PORT=3000
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-random-secret-minimum-32-chars"
APP_BASE_URL="http://localhost:5173"

# ─── Email / SMTP (for project invite emails) ─────────────────────────────────
# Leave all blank to use console-logging fallback (prints invite link to server log).
#
# Gmail Setup:
#   1. Enable 2-Step Verification at myaccount.google.com/security
#   2. Go to myaccount.google.com/apppasswords
#   3. Create an App Password → copy the 16-char password
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="DocApproval Engine <your-gmail@gmail.com>"
